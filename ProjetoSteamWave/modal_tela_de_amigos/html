<!-- ======================== OVERLAY DO MODAL ======================== -->
<div
  id="modal-amigos-overlay"
  style="
    display: none;
    position: fixed;
    inset: 0;
    z-index: 900;
    align-items: center;
    justify-content: center;
  "
  onclick="fecharModalAmigos(event)"
>

  <div id="modal-amigos-bg" style="
    position: absolute;
    inset: 0;
    background: rgba(8, 0, 15, 0.88);
    backdrop-filter: blur(6px);
  ">
    <div id="modal-scanline" style="
      position: absolute;
      left: 0; right: 0;
      height: 2px;
      background: linear-gradient(90deg, transparent, rgba(0,234,255,0.18), transparent);
      animation: modalScanLine 5s linear infinite;
      pointer-events: none;
    "></div>
    <div style="
      position: absolute;
      inset: 0;
      background-image:
        repeating-linear-gradient(0deg, rgba(155,48,255,0.04) 0px, transparent 1px, transparent 60px),
        repeating-linear-gradient(90deg, rgba(155,48,255,0.04) 0px, transparent 1px, transparent 60px);
      pointer-events: none;
    "></div>
  </div>

  <div
    id="modal-amigos-janela"
    style="
      position: relative;
      z-index: 10;
      width: 540px;
      max-height: 88vh;
      display: flex;
      flex-direction: column;
      background: #0d0020;
      border: 2px solid #fff;
      border-right-color: #1a0040;
      border-bottom-color: #1a0040;
      box-shadow:
        inset 1px 1px 0 rgba(155,48,255,0.3),
        4px 4px 0 #000,
        0 0 40px rgba(123,47,255,0.35),
        0 0 80px rgba(0,234,255,0.08);
      animation: modalEntrada 0.22s ease-out;
    "
    onclick="event.stopPropagation()"
  >

    <div style="
      background: linear-gradient(90deg, #1a0060 0%, #0d0030 60%, #1a0060 100%);
      padding: 5px 8px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(123,47,255,0.6);
      flex-shrink: 0;
      user-select: none;
    ">
      <div style="display:flex;align-items:center;gap:8px;">
        <span style="font-size:14px;line-height:1;">👥</span>
        <span style="
          font-family: var(--pixel-font);
          font-size: 9px;
          color: #00eaff;
          letter-spacing: 2px;
          text-shadow: 0 0 8px rgba(0,234,255,0.7);
        ">AMIGOS ONLINE</span>
      </div>
      <div style="display:flex;gap:3px;">
        <div class="win-btn" style="background:#c0c0c0;color:#000;">_</div>
        <div class="win-btn" style="background:#c0c0c0;color:#000;">□</div>
        <div
          class="win-btn"
          style="background:#cc0000;color:#fff;border-color:#ff4444;border-right-color:#880000;border-bottom-color:#880000;"
          onclick="fecharModalAmigos()"
        >✕</div>
      </div>
    </div>

    <div style="
      background: #0a0018;
      border-bottom: 1px solid rgba(123,47,255,0.3);
      padding: 4px 10px;
      display: flex;
      gap: 20px;
      flex-shrink: 0;
    ">
      <span onclick="setAbaModal('todos')"  id="aba-todos"    class="modal-aba modal-aba-ativa">TODOS</span>
      <span onclick="setAbaModal('online')" id="aba-online"   class="modal-aba">ONLINE</span>
      <span onclick="setAbaModal('jogando')"id="aba-jogando"  class="modal-aba">JOGANDO</span>
      <span onclick="setAbaModal('offline')"id="aba-offline"  class="modal-aba">OFFLINE</span>
    </div>

    <div style="
      padding: 8px 10px;
      border-bottom: 1px solid rgba(123,47,255,0.25);
      background: #0d0020;
      display: flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    ">
      <span style="color:rgba(123,47,255,0.7);font-size:12px;">🔍</span>
      <input
        id="modal-busca"
        type="text"
        placeholder="Buscar amigo..."
        oninput="filtrarModalAmigos()"
        style="
          flex: 1;
          background: rgba(123,47,255,0.12);
          border: 1px solid rgba(123,47,255,0.3);
          padding: 5px 10px;
          color: rgba(220,200,255,0.9);
          font-family: var(--pixel-font);
          font-size: 8px;
          outline: none;
          transition: border-color 0.2s, box-shadow 0.2s;
        "
        onfocus="this.style.borderColor='rgba(0,234,255,0.6)';this.style.boxShadow='0 0 8px rgba(0,234,255,0.2)'"
        onblur="this.style.borderColor='rgba(123,47,255,0.3)';this.style.boxShadow='none'"
      />
      <span id="modal-contador" style="
        font-family: var(--pixel-font);
        font-size: 7px;
        color: rgba(123,47,255,0.6);
        white-space: nowrap;
        min-width: 60px;
        text-align: right;
      ">5 online</span>
    </div>

    <div
      id="modal-lista-amigos"
      style="
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
        min-height: 200px;
        max-height: 380px;
      "
    ></div>

    <div style="
      background: #0a0018;
      border-top: 1px solid rgba(123,47,255,0.4);
      padding: 8px 12px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
    ">
      <span style="
        font-family: var(--pixel-font);
        font-size: 7px;
        color: rgba(123,47,255,0.5);
        letter-spacing: 1px;
      ">STEAMWAVE v1.0 — LISTA DE AMIGOS</span>

      <button
        onclick="showToast('➕ Em breve: adicionar amigos por nome ou código!')"
        style="
          background: linear-gradient(135deg, rgba(123,47,255,0.4), rgba(0,234,255,0.2));
          border: 1px solid rgba(0,234,255,0.4);
          color: #00eaff;
          font-family: var(--pixel-font);
          font-size: 7px;
          padding: 5px 12px;
          cursor: pointer;
          letter-spacing: 1px;
          transition: all 0.25s;
        "
        onmouseover="this.style.background='rgba(0,234,255,0.25)';this.style.boxShadow='0 0 12px rgba(0,234,255,0.3)'"
        onmouseout="this.style.background='linear-gradient(135deg,rgba(123,47,255,0.4),rgba(0,234,255,0.2))';this.style.boxShadow='none'"
>+ ADICIONAR AMIGO</button>
</div>

</div>
</div>