@keyframes modalEntrada {
  from { opacity: 0; transform: scale(0.93) translateY(16px); }
  to   { opacity: 1; transform: scale(1) translateY(0); }
}
@keyframes modalScanLine {
  0%   { top: -4px; }
  100% { top: 100%; }
}

.modal-aba {
  font-family: var(--pixel-font);
  font-size: 8px;
  color: rgba(123,47,255,0.5);
  cursor: pointer;
  padding: 3px 0 4px;
  letter-spacing: 1px;
  border-bottom: 2px solid transparent;
  transition: color 0.2s, border-color 0.2s;
}
.modal-aba:hover { color: rgba(0,234,255,0.75); }
.modal-aba-ativa {
  color: #00eaff !important;
  border-bottom-color: #00eaff !important;
  text-shadow: 0 0 8px rgba(0,234,255,0.5);
}

.modal-section-label {
  font-family: var(--pixel-font);
  font-size: 7px;
  color: rgba(123,47,255,0.45);
  letter-spacing: 2px;
  padding: 10px 14px 5px;
  border-top: 1px solid rgba(123,47,255,0.12);
}
.modal-section-label:first-child { border-top: none; }

.modal-amigo-row {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 9px 14px;
  border-bottom: 1px solid rgba(123,47,255,0.1);
  cursor: pointer;
  transition: background 0.15s;
  position: relative;
}
.modal-amigo-row:hover { background: rgba(123,47,255,0.14); }
.modal-amigo-row:hover .modal-amigo-acoes { opacity: 1; }

.modal-avatar {
  width: 38px;
  height: 38px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20px;
  position: relative;
  border: 1px solid rgba(123,47,255,0.25);
  background: #1a003a;
}
.modal-status-dot {
  position: absolute;
  bottom: -2px; right: -2px;
  width: 10px; height: 10px;
  border-radius: 50%;
  border: 2px solid #0d0020;
}
.dot-online  { background: #00cc55; box-shadow: 0 0 6px #00cc55; }
.dot-jogando { background: #00eaff; box-shadow: 0 0 6px #00eaff; }
.dot-ausente { background: #ffaa00; box-shadow: 0 0 4px #ffaa00; }
.dot-offline { background: #444; }

.modal-amigo-info { flex: 1; min-width: 0; }
.modal-amigo-nome {
  font-family: var(--pixel-font);
  font-size: 9px;
  color: rgba(220,200,255,0.95);
  margin-bottom: 3px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.modal-amigo-atividade {
  font-family: var(--vt-font);
  font-size: 15px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: rgba(155,120,220,0.7);
  line-height: 1;
}
.modal-amigo-atividade.jogando {
  color: #00eaff;
  text-shadow: 0 0 6px rgba(0,234,255,0.4);
}

.modal-amigo-acoes {
  display: flex;
  gap: 4px;
  opacity: 0;
  transition: opacity 0.2s;
  flex-shrink: 0;
}
.modal-acao-btn {
  width: 26px; height: 26px;
  background: #0a0018;
  border: 1px solid rgba(123,47,255,0.4);
  color: rgba(123,47,255,0.8);
  font-size: 13px;
  display: flex; align-items: center; justify-content: center;
  cursor: pointer;
  transition: all 0.15s;
}
.modal-acao-btn:hover {
  background: rgba(123,47,255,0.5);
  color: #fff;
  border-color: rgba(0,234,255,0.6);
  box-shadow: 0 0 8px rgba(0,234,255,0.2);
}

.modal-empty {
  padding: 40px 20px;
  text-align: center;
  font-family: var(--pixel-font);
  font-size: 8px;
  color: rgba(123,47,255,0.4);
  letter-spacing: 1px;
  line-height: 2.2;
}

#modal-lista-amigos::-webkit-scrollbar { width: 5px; }
#modal-lista-amigos::-webkit-scrollbar-track { background: #0d0020; }
#modal-lista-amigos::-webkit-scrollbar-thumb { background: rgba(123,47,255,0.5); }
#modal-lista-amigos::-webkit-scrollbar-thumb:hover { background: rgba(0,234,255,0.5); }